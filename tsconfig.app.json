{
  "compilerOptions": {
    // Incremental cache (under node_modules/, gitignored)
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    // Keep until we migrate off baseUrl in TS 6+
    "ignoreDeprecations": "6.0",

    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],

    "module": "ESNext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "skipLibCheck": true,

    // Bundler mode: Vite emits JS; tsc only checks types
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",
    "resolveJsonModule": true,

    // Keep in sync with vite.config.ts / vitest.config.ts
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@courses/*": ["./.courses/*"]
    },

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", ".courses"]
}
