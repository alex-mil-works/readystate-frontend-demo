# Local authoring (default). Full curriculum in `.courses/` (gitignored).
VITE_DEMO=false
VITE_CONTENT_SOURCE=local

# Demo build locally (same slice as CI / production deploy):
# VITE_DEMO=true
# VITE_CONTENT_SOURCE=demo
# CONTENT_SOURCE=demo
# yarn build
# Or: yarn content:compile:demo && yarn build

# Production deploy env lives in GitHub Actions (Variables + Secrets), not here.
# See .github/DEPLOY.md — do not duplicate in Vercel project settings.

# Soft site gate (optional; password ends up in the client bundle — not real security)
# VITE_SITE_PASSWORD=

# Compiler override (optional). Prefer VITE_CONTENT_SOURCE / CONTENT_SOURCE.
# COURSES_DIR=courses-demo
# CONTENT_SOURCE=demo
